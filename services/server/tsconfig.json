{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/testing.ts",
    "src/**/testing/**",
    "src/pacs-index/index-suite.ts",
    "src/pacs-index/postgres-testing.ts"
  ],
  "references": [
    {
      "path": "../../packages/dicom"
    }
  ]
}
