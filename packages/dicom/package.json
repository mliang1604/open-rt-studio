{
  "name": "@open-rt-studio/dicom",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free DICOM core for Open RT Studio: runs in browsers, workers and Node.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "pretest": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "posttest": "npm run build && node --test \"test/*.test.mjs\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.3",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.2",
    "@cornerstonejs/codec-openjpeg": "^1.3.0",
    "dicom-parser": "^1.8.21"
  }
}
